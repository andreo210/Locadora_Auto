@page "/veiculos/{id:int}/manutencao"
@using Locadora_Auto.Front.Components.Notificacao
@using Locadora_Auto.Front.Models.Enum
@using Locadora_Auto.Front.Models.Request.Veiculo
@using Locadora_Auto.Front.Models.Response
@using Locadora_Auto.Front.Models.Validadores
@using Locadora_Auto.Front.Services.Servicos.Veiculo
@using Locadora_Auto.Front.Services.Utils.Notificacao
@inject NavigationManager Navegacao
@inject INotificationService NotificacaoService
@inject IVeiculoService _veiculoService
@inject IConfirmDialogService ConfirmService
@inject ILogger<ManutencaoVeiculo> Logger
@* @attribute [Authorize(Roles = "Administrador, Gerente")] *@
@rendermode InteractiveServer

<!-- Componente de confirmação -->
<ConfirmDialog @ref="confirmDialog" />

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-sm" @onclick="Voltar">
                    <i class="bi bi-arrow-left"></i> Voltar
                </button>
                <h2 class="mb-0">Manutenção do Veículo</h2>
            </div>
            <p class="text-muted mt-2">Registre e acompanhe as manutenções do veículo</p>
        </div>
    </div>

    @if (carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="mt-2">Carregando manutenções...</p>
        </div>
    }
    else if (veiculo == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Veículo não encontrado ou não existe.
        </div>
    }
    else
    {
        <!-- Resumo do veículo -->
        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="mb-1">@veiculo.Placa — @veiculo.Descricao</h5>
                    <span class="text-muted small">
                        @veiculo.Categoria · @veiculo.Filial · @veiculo.KmAtual.ToString("N0") km
                    </span>
                </div>
                <div>
                    <span class="badge @(((StatusVeiculoEnum)veiculo.IdStatus).GetCorBadge())">
                        @(((StatusVeiculoEnum)veiculo.IdStatus).GetDisplayName())
                    </span>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Nova manutenção -->
            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-plus-circle me-2"></i>
                            Iniciar Manutenção
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (VeiculoEmManutencao)
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                Este veículo já está em manutenção. Encerre ou cancele a manutenção aberta antes de abrir outra.
                            </div>
                        }
                        else if (veiculo.IdStatus == (int)StatusVeiculoEnum.Locado)
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                Veículo locado não pode entrar em manutenção.
                            </div>
                        }
                        else
                        {
                            <EditForm Model="@novaManutencao" OnValidSubmit="@IniciarManutencao">
                                <div class="mb-3">
                                    <label class="form-label">Tipo <span class="text-danger">*</span></label>
                                    <InputSelect @bind-Value="novaManutencao.IdTipoManutencao" class="form-select">
                                        <option value="0">Selecione o tipo</option>
                                        @foreach (var tipo in System.Enum.GetValues<TipoManutencaoEnum>())
                                        {
                                            <option value="@((int)tipo)">@tipo.GetDisplayName()</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Descrição <span class="text-danger">*</span></label>
                                    <InputTextArea @bind-Value="novaManutencao.Descricao" class="form-control" rows="4"
                                                   placeholder="Descreva o que será feito" />
                                </div>
                                <button type="submit" class="btn btn-primary w-100" disabled="@processando">
                                    @if (processando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        <span>Salvando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-tools me-1"></i>
                                        <span>Iniciar Manutenção</span>
                                    }
                                </button>
                            </EditForm>
                        }
                    </div>
                </div>
            </div>

            <!-- Histórico -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Histórico de Manutenções</h5>
                        <span class="text-muted small">
                            Custo total: <strong>@manutencoes.Sum(m => m.Custo).ToString("C")</strong>
                        </span>
                    </div>

                    @if (!manutencoes.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-tools fs-1 text-muted"></i>
                            <h5 class="mt-3">Nenhuma manutenção registrada</h5>
                            <p class="text-muted">Use o formulário ao lado para registrar a primeira.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Descrição</th>
                                        <th width="110">Início</th>
                                        <th width="110">Fim</th>
                                        <th width="110" class="text-end">Custo</th>
                                        <th width="120">Status</th>
                                        <th width="130">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var manutencao in manutencoes)
                                    {
                                        <tr>
                                            <td>@manutencao.Tipo</td>
                                            <td>
                                                @if (idManutencaoEditando == manutencao.IdManutencao)
                                                {
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control" @bind="descricaoEditada" />
                                                        <button class="btn btn-success" title="Salvar"
                                                                @onclick="() => SalvarDescricao(manutencao)">
                                                            <i class="bi bi-check"></i>
                                                        </button>
                                                        <button class="btn btn-secondary" title="Cancelar"
                                                                @onclick="CancelarEdicaoDescricao">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @manutencao.Descricao
                                                }
                                            </td>
                                            <td>@manutencao.DataInicio.ToString("dd/MM/yyyy")</td>
                                            <td>@(manutencao.DataFim?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td class="text-end">@manutencao.Custo.ToString("C")</td>
                                            <td>
                                                <span class="badge @(((StatusManutencaoEnum)manutencao.IdStatus).GetCorBadge())">
                                                    @(((StatusManutencaoEnum)manutencao.IdStatus).GetDisplayName())
                                                </span>
                                            </td>
                                            <td>
                                                @if (EstaAberta(manutencao))
                                                {
                                                    <div class="btn-group" role="group">
                                                        <button class="btn btn-sm btn-outline-primary" title="Editar descrição"
                                                                @onclick="() => EditarDescricao(manutencao)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-success" title="Encerrar"
                                                                @onclick="() => AbrirEncerramento(manutencao)">
                                                            <i class="bi bi-check-circle"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" title="Cancelar"
                                                                @onclick="() => CancelarManutencao(manutencao)">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Encerramento de manutenção -->
@if (manutencaoEncerrando != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-check-circle me-2"></i>
                        Encerrar Manutenção
                    </h5>
                    <button type="button" class="btn-close" @onclick="FecharEncerramento"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">
                        <strong>@manutencaoEncerrando.Tipo</strong>
                        <span class="text-muted">— iniciada em @manutencaoEncerrando.DataInicio.ToString("dd/MM/yyyy")</span>
                    </p>
                    <label class="form-label">Custo total <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0" class="form-control" @bind="custoEncerramento" />
                    <div class="form-text">Informe 0 caso a manutenção não tenha gerado custo.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharEncerramento">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmarEncerramento" disabled="@processando">
                        <i class="bi bi-check-circle me-1"></i>Encerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== PARÂMETROS DA ROTA =====
    [Parameter] public int id { get; set; }

    // ===== REFERÊNCIA PARA O COMPONENTE DE CONFIRMAÇÃO =====
    private ConfirmDialog? confirmDialog;

    // ===== VARIÁVEIS DE ESTADO =====
    private VeiculoResponse? veiculo;
    private List<ManutencaoResponse> manutencoes = new();
    private IniciarManutencaoRequest novaManutencao = new();
    private bool carregando = true;
    private bool processando;

    // edição de descrição em linha
    private int? idManutencaoEditando;
    private string descricaoEditada = string.Empty;

    // encerramento
    private ManutencaoResponse? manutencaoEncerrando;
    private decimal custoEncerramento;

    private bool VeiculoEmManutencao => manutencoes.Any(EstaAberta);

    private static bool EstaAberta(ManutencaoResponse manutencao) =>
        manutencao.IdStatus == (int)StatusManutencaoEnum.Aberta ||
        manutencao.IdStatus == (int)StatusManutencaoEnum.EmAndamento;

    // ===== MÉTODOS DO CICLO DE VIDA =====
    protected override async Task OnParametersSetAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        try
        {
            carregando = true;
            StateHasChanged();

            veiculo = await _veiculoService.ObterPorId(id);

            if (veiculo == null)
            {
                Logger.LogWarning("Veículo não encontrado: {VeiculoId}", id);
                NotificacaoService.ShowWarning("Veículo não encontrado", "Atenção");
                return;
            }

            manutencoes = await _veiculoService.ObterManutencoes(id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar manutenções do veículo {VeiculoId}", id);
            NotificacaoService.ShowError($"Erro ao carregar manutenções: {ex.Message}", "Erro");
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    // ===== INICIAR =====
    private async Task IniciarManutencao()
    {
        processando = true;
        StateHasChanged();

        try
        {
            var validador = new IniciarManutencaoValidator();
            var resultado = await validador.ValidateAsync(novaManutencao);

            if (!resultado.IsValid)
            {
                var erros = resultado.Errors
                    .GroupBy(e => e.PropertyName)
                    .ToDictionary(g => g.Key, g => g.Select(e => e.ErrorMessage).ToArray());

                NotificacaoService.ShowValidationErrors(erros);
                return;
            }

            var sucesso = await _veiculoService.IniciarManutencao(id, novaManutencao);

            if (sucesso)
            {
                NotificacaoService.ShowSuccess("Manutenção iniciada com sucesso!", "Sucesso");
                novaManutencao = new();
                await CarregarDados();
            }
            else
            {
                NotificacaoService.ShowWarning("Não foi possível iniciar a manutenção", "Atenção");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao iniciar manutenção do veículo {VeiculoId}", id);
            NotificacaoService.ShowError($"Erro ao iniciar manutenção: {ex.Message}", "Erro");
        }
        finally
        {
            processando = false;
            StateHasChanged();
        }
    }

    // ===== ENCERRAR =====
    private void AbrirEncerramento(ManutencaoResponse manutencao)
    {
        manutencaoEncerrando = manutencao;
        custoEncerramento = manutencao.Custo;
    }

    private void FecharEncerramento()
    {
        manutencaoEncerrando = null;
        custoEncerramento = 0;
    }

    private async Task ConfirmarEncerramento()
    {
        if (manutencaoEncerrando == null) return;

        var request = new TerminarManutencaoRequest
        {
            IdManutencao = manutencaoEncerrando.IdManutencao,
            Custo = custoEncerramento
        };

        processando = true;
        StateHasChanged();

        try
        {
            var validador = new TerminarManutencaoValidator();
            var resultado = await validador.ValidateAsync(request);

            if (!resultado.IsValid)
            {
                var erros = resultado.Errors
                    .GroupBy(e => e.PropertyName)
                    .ToDictionary(g => g.Key, g => g.Select(e => e.ErrorMessage).ToArray());

                NotificacaoService.ShowValidationErrors(erros);
                return;
            }

            var sucesso = await _veiculoService.TerminarManutencao(id, request);

            if (sucesso)
            {
                NotificacaoService.ShowSuccess("Manutenção encerrada com sucesso!", "Sucesso");
                FecharEncerramento();
                await CarregarDados();
            }
            else
            {
                NotificacaoService.ShowWarning("Não foi possível encerrar a manutenção", "Atenção");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao encerrar manutenção do veículo {VeiculoId}", id);
            NotificacaoService.ShowError($"Erro ao encerrar manutenção: {ex.Message}", "Erro");
        }
        finally
        {
            processando = false;
            StateHasChanged();
        }
    }

    // ===== CANCELAR =====
    private async Task CancelarManutencao(ManutencaoResponse manutencao)
    {
        var confirmado = await ConfirmService.ConfirmAsync(
            $"Deseja realmente cancelar a manutenção '{manutencao.Tipo}' iniciada em {manutencao.DataInicio:dd/MM/yyyy}?",
            "Confirmar Cancelamento");

        if (!confirmado)
            return;

        try
        {
            var sucesso = await _veiculoService.CancelarManutencao(id, manutencao.IdManutencao);

            if (sucesso)
            {
                NotificacaoService.ShowSuccess("Manutenção cancelada com sucesso!", "Sucesso");
                await CarregarDados();
            }
            else
            {
                NotificacaoService.ShowWarning("Não foi possível cancelar a manutenção", "Atenção");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao cancelar manutenção do veículo {VeiculoId}", id);
            NotificacaoService.ShowError($"Erro ao cancelar manutenção: {ex.Message}", "Erro");
        }
    }

    // ===== EDIÇÃO DE DESCRIÇÃO =====
    private void EditarDescricao(ManutencaoResponse manutencao)
    {
        idManutencaoEditando = manutencao.IdManutencao;
        descricaoEditada = manutencao.Descricao ?? string.Empty;
    }

    private void CancelarEdicaoDescricao()
    {
        idManutencaoEditando = null;
        descricaoEditada = string.Empty;
    }

    private async Task SalvarDescricao(ManutencaoResponse manutencao)
    {
        if (string.IsNullOrWhiteSpace(descricaoEditada))
        {
            NotificacaoService.ShowWarning("A descrição é obrigatória", "Validação");
            return;
        }

        try
        {
            var sucesso = await _veiculoService.AtualizarManutencao(id, new AtualizarManutencaoRequest
            {
                IdManutencao = manutencao.IdManutencao,
                Descricao = descricaoEditada.Trim()
            });

            if (sucesso)
            {
                NotificacaoService.ShowSuccess("Descrição atualizada com sucesso!", "Sucesso");
                CancelarEdicaoDescricao();
                await CarregarDados();
            }
            else
            {
                NotificacaoService.ShowWarning("Não foi possível atualizar a descrição", "Atenção");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao atualizar descrição da manutenção do veículo {VeiculoId}", id);
            NotificacaoService.ShowError($"Erro ao atualizar descrição: {ex.Message}", "Erro");
        }
    }

    // ===== MÉTODOS DE NAVEGAÇÃO =====
    private void Voltar()
    {
        Navegacao.NavigateTo($"/veiculos/visualizar/{id}");
    }
}
