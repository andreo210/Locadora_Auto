@page "/seguros/editar/{id:int}"
@using Blazored.FluentValidation
@using Locadora_Auto.Front.Components.Forms
@using Locadora_Auto.Front.Models.Request.Seguro
@using Locadora_Auto.Front.Models.Response
@using Locadora_Auto.Front.Models.Validadores
@using Locadora_Auto.Front.Services.Servicos.Seguro
@using Locadora_Auto.Front.Services.Utils.Notificacao
@inject NavigationManager Navegacao
@inject INotificationService NotificacaoService
@inject ISeguroService _seguroService
@inject ILogger<EditarSeguro> Logger
@* @attribute [Authorize(Roles = "Administrador")] *@
@rendermode InteractiveServer

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-sm" @onclick="Voltar">
                    <i class="bi bi-arrow-left"></i> Voltar
                </button>
                <h2 class="mb-0">Editar Seguro</h2>
            </div>
            <p class="text-muted mt-2">Altere os dados do seguro</p>
        </div>
    </div>

    @if (carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="mt-2">Carregando dados do seguro...</p>
        </div>
    }
    else if (seguroOriginal == null || seguroEdit == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Seguro não encontrado ou não existe.
        </div>
    }
    else
    {
        <EditForm Model="@seguroEdit" OnValidSubmit="@ManipularEnvio">
            <FluentValidationValidator @ref="validadorFluent" />

            <div class="row">
                <div class="col-md-8 mx-auto">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-shield-check me-2"></i>
                                Dados do Seguro
                            </h5>
                            <span class="badge @(seguroOriginal.Ativo ? "bg-success" : "bg-danger")">
                                @(seguroOriginal.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </div>
                        <div class="card-body">
                            <!-- Nome -->
                            <div class="mb-3">
                                <label class="form-label">Nome <span class="text-danger">*</span></label>
                                <InputText @bind-Value="seguroEdit.Nome" class="form-control" placeholder="Ex: Proteção Total" />
                                <ValidationMessage For="@(() => seguroEdit.Nome)" />
                            </div>

                            <!-- Descrição -->
                            <div class="mb-3">
                                <label class="form-label">Descrição <span class="text-danger">*</span></label>
                                <InputTextArea @bind-Value="seguroEdit.Descricao" class="form-control" rows="2"
                                               placeholder="Descreva resumidamente o seguro" />
                                <ValidationMessage For="@(() => seguroEdit.Descricao)" />
                                <small class="form-text text-muted">Máximo de 100 caracteres.</small>
                            </div>

                            <div class="row">
                                <!-- Valor da diária -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Valor da diária <span class="text-danger">*</span></label>
                                    <InputMoeda @bind-Value="seguroEdit.ValorDiaria"
                                                class="form-control"
                                                placeholder="R$ 0,00" />
                                    <ValidationMessage For="@(() => seguroEdit.ValorDiaria)" />
                                </div>

                                <!-- Franquia -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Franquia</label>
                                    <InputMoeda @bind-Value="seguroEdit.Franquia"
                                                class="form-control"
                                                placeholder="R$ 0,00" />
                                    <ValidationMessage For="@(() => seguroEdit.Franquia)" />
                                </div>
                            </div>

                            <!-- Cobertura -->
                            <div class="mb-0">
                                <label class="form-label">Cobertura <span class="text-danger">*</span></label>
                                <InputTextArea @bind-Value="seguroEdit.Cobertura" class="form-control" rows="3"
                                               placeholder="Ex: Colisão, roubo, furto e danos a terceiros" />
                                <ValidationMessage For="@(() => seguroEdit.Cobertura)" />
                                <small class="form-text text-muted">Máximo de 200 caracteres.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-8 mx-auto">
                    <div class="d-flex gap-2 justify-content-between">
                        <div>
                            @if (seguroOriginal.Ativo)
                            {
                                <button type="button" class="btn btn-outline-danger" disabled="@processando" @onclick="Desativar">
                                    <i class="bi bi-slash-circle me-1"></i>Desativar
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-success" disabled="@processando" @onclick="Ativar">
                                    <i class="bi bi-check-circle me-1"></i>Ativar
                                </button>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                <i class="bi bi-x-circle me-1"></i>Cancelar
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@processando">
                                @if (processando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Salvando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-1"></i>
                                    <span>Salvar Alterações</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int id { get; set; }

    private SeguroResponse? seguroOriginal;
    private EditarSeguroRequest? seguroEdit;
    private bool carregando = true;
    private bool processando;
    private FluentValidationValidator? validadorFluent;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosSeguro();
    }

    // ===== MÉTODO DE CARREGAMENTO =====
    private async Task CarregarDadosSeguro()
    {
        try
        {
            carregando = true;
            StateHasChanged();

            seguroOriginal = await _seguroService.ObterPorId(id);

            if (seguroOriginal == null)
            {
                Logger.LogWarning("Seguro não encontrado: {SeguroId}", id);
                NotificacaoService.ShowWarning("Seguro não encontrado", "Atenção");
                return;
            }

            seguroEdit = new EditarSeguroRequest
            {
                Nome = seguroOriginal.Nome,
                Descricao = seguroOriginal.Descricao,
                ValorDiaria = seguroOriginal.ValorDiaria,
                Franquia = seguroOriginal.Franquia,
                Cobertura = seguroOriginal.Cobertura
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar seguro {SeguroId}", id);
            NotificacaoService.ShowError("Erro ao carregar dados do seguro", "Erro");
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    // ===== MÉTODO PRINCIPAL DE ENVIO =====
    private async Task ManipularEnvio()
    {
        if (seguroEdit == null) return;

        processando = true;
        StateHasChanged();

        try
        {
            var validador = new EditarSeguroValidator();
            var resultado = await validador.ValidateAsync(seguroEdit);

            if (!resultado.IsValid)
            {
                var erros = resultado.Errors
                    .GroupBy(e => e.PropertyName)
                    .ToDictionary(g => g.Key, g => g.Select(e => e.ErrorMessage).ToArray());

                NotificacaoService.ShowValidationErrors(erros);
                return;
            }

            var sucesso = await _seguroService.Atualizar(id, seguroEdit);

            if (sucesso == true)
            {
                NotificacaoService.ShowSuccess("Seguro atualizado com sucesso!", "Sucesso");
                await Task.Delay(1500);
                Navegacao.NavigateTo($"/seguros/visualizar/{id}");
            }
            else
            {
                Logger.LogWarning("Falha ao atualizar seguro {SeguroId}", id);
                NotificacaoService.ShowWarning("Não foi possível atualizar o seguro", "Atenção");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ERRO ao editar seguro {SeguroId}", id);
            NotificacaoService.ShowError($"Erro ao atualizar seguro: {ex.Message}", "Erro");
        }
        finally
        {
            processando = false;
            StateHasChanged();
        }
    }

    // ===== ATIVAR / DESATIVAR =====
    private async Task Ativar() => await AlterarSituacao(ativar: true);

    private async Task Desativar() => await AlterarSituacao(ativar: false);

    private async Task AlterarSituacao(bool ativar)
    {
        processando = true;
        StateHasChanged();

        try
        {
            var sucesso = ativar
                ? await _seguroService.Ativar(id)
                : await _seguroService.Desativar(id);

            if (sucesso)
            {
                NotificacaoService.ShowSuccess($"Seguro {(ativar ? "ativado" : "desativado")} com sucesso!", "Sucesso");
                await CarregarDadosSeguro();
            }
            else
            {
                NotificacaoService.ShowWarning($"Não foi possível {(ativar ? "ativar" : "desativar")} o seguro", "Atenção");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao alterar situação do seguro {SeguroId}", id);
            NotificacaoService.ShowError($"Erro ao alterar situação: {ex.Message}", "Erro");
        }
        finally
        {
            processando = false;
            StateHasChanged();
        }
    }

    // ===== MÉTODOS DE NAVEGAÇÃO =====
    private void Voltar() => Navegacao.NavigateTo($"/seguros/visualizar/{id}");

    private void Cancelar() => Voltar();
}
