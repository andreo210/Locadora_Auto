@page "/filial/nova"
@using Blazored.FluentValidation
@using Locadora_Auto.Front.Components.Forms
@using Locadora_Auto.Front.Models.Request
@using Locadora_Auto.Front.Models.Request.Filial
@using Locadora_Auto.Front.Models.Validadores
@using Locadora_Auto.Front.Services.Servicos.Filial
@using Locadora_Auto.Front.Services.Servicos.Funcionario
@using Locadora_Auto.Front.Services.Utils.Notificacao
@inject NavigationManager Navegacao
@inject INotificationService NotificacaoService
@inject IFilialService _filialService
@* @attribute [Authorize(Roles = "Administrador")] *@
@rendermode InteractiveServer

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-sm" @onclick="Cancelar">
                    <i class="bi bi-arrow-left"></i> Voltar
                </button>
                <h2 class="mb-0">Nova Filial</h2>
            </div>
            <p class="text-muted mt-2">Preencha os dados para cadastrar uma nova filial</p>
        </div>
    </div>

    <EditForm Model="@filial" OnValidSubmit="@ManipularEnvio">
        <FluentValidationValidator @ref="validadorFluent" />

        <div class="row">
            <div class="col-md-8 mx-auto">
                <!-- Dados da filial -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Dados da Filial</h5>
                    </div>
                    <div class="card-body">
                        <!-- Nome -->
                        <div class="mb-0">
                            <label class="form-label">Nome <span class="text-danger">*</span></label>
                            <InputText @bind-Value="filial.Nome" class="form-control" placeholder="Digite o nome da filial" />
                            <ValidationMessage For="@(() => filial.Nome)" />
                        </div>
                    </div>
                </div>

                <!-- Endereço -->
                <EnderecoForm @bind-Endereco="filial.Endereco" Titulo="Endereço da Filial" />

                <div class="row mt-4">
                    <div class="col">
                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                <i class="bi bi-x-circle me-1"></i>Cancelar
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@processando">
                                @if (processando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Salvando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-1"></i>
                                    <span>Salvar Filial</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private CriarFilialRequest filial = new();
    private bool processando;
    private FluentValidationValidator? validadorFluent;
    
    protected override void OnInitialized()
    {
        // Inicializa o objeto Endereco se for necessário
        if (filial.Endereco == null)
        {
            filial.Endereco = new EnderecoRequest();
        }
    }



    private async Task ManipularEnvio()
    {
        processando = true;
        StateHasChanged();

        try
        {
            // Valida o modelo usando FluentValidation
            var validador = new FilialValidator();
            var resultado = await validador.ValidateAsync(filial);

            if (!resultado.IsValid)
            {
                var erros = resultado.Errors
                    .GroupBy(e => e.PropertyName)
                    .ToDictionary(g => g.Key, g => g.Select(e => e.ErrorMessage).ToArray());

                NotificacaoService.ShowValidationErrors(erros);
                processando = false;
                StateHasChanged();
                return;
            }

            if (!ValidarEndereco())
            {
                processando = false;
                StateHasChanged();
                return;
            }

            // Chama o serviço para inserir a filial
            var filialCriada = await _filialService.Inserir(filial);

            if (filialCriada != null)
            {
                NotificacaoService.ShowSuccess("Filial cadastrada com sucesso!", "Cadastro Realizado");
                await Task.Delay(1500);
                Navegacao.NavigateTo("/filiais");
            }
            else
            {
                NotificacaoService.ShowError("Erro ao cadastrar filial.", "Erro no Cadastro");
            }
        }
        catch (Exception ex)
        {
            NotificacaoService.ShowError($"Erro ao cadastrar filial: {ex.Message}", "Erro no Cadastro");
        }
        finally
        {
            processando = false;
            StateHasChanged();
        }
    }

    // ===== VALIDAÇÃO ADICIONAL =====
    private bool ValidarEndereco()
    {
        if (filial.Endereco == null || string.IsNullOrWhiteSpace(filial.Endereco.Cidade))
        {
            NotificacaoService.ShowWarning("A cidade do endereço é obrigatória", "Validação");
            return false;
        }

        if (string.IsNullOrWhiteSpace(filial.Endereco.Logradouro))
        {
            NotificacaoService.ShowWarning("O logradouro é obrigatório", "Validação");
            return false;
        }

        return true;
    }

    // ===== MÉTODOS DE NAVEGAÇÃO =====
    private void Cancelar()
    {
        Navegacao.NavigateTo("/filiais");
    }
}