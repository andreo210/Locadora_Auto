@* Declare na página que confirma: <ConfirmDialog @ref="confirmDialog" />
   Substitui o confirm() do navegador, que bloqueia o circuito do Blazor Server. *@
@namespace {{RootNamespace}}.Front.Components.Notificacao
@using {{RootNamespace}}.Front.Services.Utils.Notificacao
@inject IConfirmDialogService ConfirmService
@implements IDisposable

@if (_visivel)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_titulo</h5>
                    <button type="button" class="btn-close" @onclick="Cancelar"></button>
                </div>
                <div class="modal-body">
                    <p>@_mensagem</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancelar">Não</button>
                    <button class="btn btn-primary" @onclick="Confirmar">Sim</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _visivel;
    private string _mensagem = "";
    private string _titulo = "";

    protected override void OnInitialized() => ConfirmService.OnShow += Exibir;

    private async Task Exibir(string mensagem, string titulo)
    {
        _mensagem = mensagem;
        _titulo = titulo;
        _visivel = true;
        await InvokeAsync(StateHasChanged);
    }

    private void Confirmar()
    {
        _visivel = false;
        ConfirmService.SetResult(true);
    }

    private void Cancelar()
    {
        _visivel = false;
        ConfirmService.SetResult(false);
    }

    public void Dispose()
    {
        ConfirmService.OnShow -= Exibir;

        // Sair da página com um diálogo aberto deixaria o await pendurado para sempre.
        ConfirmService.SetResult(false);
    }
}
